@startuml POST_ports_configure_1_sync
title POST /ports/configure — parte 1/2: request HTTP hasta despachar a Celery (verificado contra código real)
autonumber

note over Cliente
  Mismo criterio que post_vlans_secuencia_real_*.puml -- cada flecha es
  una función/método real, verificado leyendo api/ports.py,
  models/port.py, schemas/port.py, services/vendors/base.py,
  services/group_operation_runner.py, services/job_queue.py y
  composition.py tal como están hoy. El bloque de middleware/auth
  (AuthContextMiddleware/get_current_user/obtener_scope) es idéntico
  en TODOS los endpoints -- acá se muestra completo igual, con notas
  más cortas porque el detalle completo (por qué es 1 solo middleware,
  qué reemplazó) ya está documentado en
  post_vlans_secuencia_real_1_sync.puml.
end note

actor Cliente
participant "AuthContextMiddleware\n(core/rls_middleware.py)" as AuthCtx
participant "get_current_user /\nrequire_authenticated\n(core/scope.py)" as Auth
participant "RoleAssignmentRepository" as RAR
participant "Router\n(api/ports.py: configure_port)" as Router
participant "config: Puerto" as PUERTO
participant "Repository[Device]" as RepoDev
participant "RedisCoordinator" as RC
participant "GroupOperationRunner" as GOR
participant "Repository[Job]" as RepoJob
participant "JobQueue" as Queue

Cliente -> AuthCtx : POST /api/v1/ports/configure\n{device:"switch-A", interface:"GigabitEthernet0/0/1",\ndescription:"Uplink NOC", mode:"access", access_vlan:20}\nAuthorization: Bearer <jwt>
activate AuthCtx
AuthCtx -> AuthCtx : decode_bearer(request)  [1 solo decode -- ver\npost_vlans_secuencia_real_1_sync.puml para el detalle\nde por qué antes eran 3 y ahora 1]
AuthCtx -> AuthCtx : _lookup_user(username)  [1 sola query bajo\nsystem_context(): id, is_active, is_system_admin]
AuthCtx -> AuthCtx : request.state.auth_payload/auth_user_row = ...\n[cachea para get_current_user()/require_authenticated()]
AuthCtx -> AuthCtx : current_user_ctx.set({"id":..., "is_system_admin":...})
AuthCtx -> AuthCtx : bucket_for(request, username) + _check_and_record()
alt límite excedido
    AuthCtx --> Cliente : 429 Too Many Requests
end
AuthCtx -> Auth : request (auth + RLS context ya instalados)
deactivate AuthCtx
activate Auth
Auth -> Auth : get_current_user(request)  [lee request.state,\nno decodifica de nuevo]
alt payload ausente o inválido
    Auth --> Cliente : 401
end
Auth -> Auth : require_authenticated(current, request)  [lee\nrequest.state.auth_user_row, no vuelve a consultar la DB]
alt user inactivo
    Auth --> Cliente : 401
end
Auth -> RAR : obtener_scope(current) -> scope_de(current)
activate RAR
alt current["is_system_admin"]
    RAR --> Auth : VisibilityScope(es_system_admin=True, grants=())
else
    RAR -> RAR : query RoleAssignmentModel WHERE user_id=...
    RAR --> Auth : VisibilityScope(es_system_admin=False, grants=(...))
end
deactivate RAR
Auth -> Router : configure_port(data, current_user, scope)
deactivate Auth
activate Router

Router -> PUERTO : Puerto(interface="GigabitEthernet0/0/1", device="",\ndescription="Uplink NOC", admin_up=None, mode="access",\naccess_vlan=20, allowed_vlans=None, allowed_vlan_operation="add")
activate PUERTO
PUERTO -> PUERTO : __post_init__() -> _validate_interface_name(self.interface)
alt interface inválida
    PUERTO --> Router : raise ValueError
    Router --> Cliente : 400 (ValidationError)
end

Router -> PUERTO : entidad.validar()
PUERTO -> PUERTO : chequea que al menos 1 de\n(description, admin_up, mode, access_vlan, allowed_vlans) no sea None
alt todos None
    PUERTO --> Router : raise ValueError
end
PUERTO -> PUERTO : self._es_composite\n[len(mutation_fields)>1 or "mode" in mutation_fields -- True acá:\n{description, mode, access_vlan}, 3 campos]
alt _es_composite
    PUERTO -> PUERTO : access_vlan is not None and mode not in ("access","trunk")?\n[acá mode="access" -- pasa]
    PUERTO -> PUERTO : allowed_vlans is not None and mode != "trunk"?\n[allowed_vlans=None -- no aplica]
end
PUERTO -> PUERTO : _validate_access_vlan_id(20)\n[rango 1-4094, no reservada 1002-1005]
PUERTO -> PUERTO : _validate_description("Uplink NOC")\n[largo <=200, sin caracteres de control]
alt algún campo inválido
    PUERTO --> Router : raise ValueError
    Router --> Cliente : 400 (ValidationError)
end
deactivate PUERTO

Router -> RepoDev : get("switch-A")
activate RepoDev
RepoDev --> Router : dev o None
deactivate RepoDev
alt device no existe
    Router --> Cliente : 404 (NotFoundError)
end

Router -> Router : _authz_device(scope, "switch-A", min_role="operator")
Router -> Router : resolver_site_group("switch-A", "device")\n-> core/scope.py: _lookup_device_scope() [query JOIN]
Router -> Router : scope.rol_para(site_id, device_group_id)  [en memoria]
alt rol insuficiente
    Router --> Cliente : 403
end

Router -> RC : _check_device_not_locked("switch-A")\n-> redis_coordinator.esta_ocupado("switch-A")
activate RC
note right of RC
  Único entre los 3 endpoints POST de ports.py (configure/shutdown/
  enable) -- /description, /admin-state, /access-vlan, /trunk-vlans
  (los 4 PATCH) NO llaman esto, van directo a encolar(). Probe NO
  bloqueante -- misma ventana TOCTOU documentada en el propio código:
  esto solo evita encolar un job que casi seguro va a chocar,
  Orquestador igual adquiere su propio lock real al ejecutar.
end note
RC --> Router : bool
deactivate RC
alt device ocupado
    Router --> Cliente : 409 {"error_code":"DEVICE_LOCKED"}
end

Router -> Router : _require_port_driver_with(dev, "configure_port")
Router -> Router : getattr(type(dev.driver), "configure_port")\nis getattr(VendorDriver, "configure_port")?\n[dev.driver ya dispara PluginRegistry.obtener()\nla 1ra vez que se accede acá]
alt driver no sobreescribe configure_port\n(sigue siendo el stub de VendorDriver)
    Router --> Cliente : 501 {"error_code":"VENDOR_NOT_SUPPORTED"}
end

Router -> GOR : encolar(entidad, ["switch-A"], current_user["username"])
activate GOR
GOR -> GOR : group_job_id = uuid4()
GOR -> GOR : parametros = asdict(recurso)
GOR -> RepoJob : add(Job(operation="puerto", device="switch-A",\ngroup_job_id=group_job_id, parameters=parametros))
activate RepoJob
RepoJob --> GOR : job (status="pending")
deactivate RepoJob
GOR -> Queue : dispatch("orquestador.ejecutar", recurso,\n"switch-A", actor, job.job_id)
activate Queue
Queue -> Queue : asdict(recurso)  [2da vez -- ver nota en\npost_vlans_secuencia_real_1_sync.puml]
Queue -> Queue : ejecutar_task.delay(recurso_dict, "puerto",\n"switch-A", actor, job_id)
deactivate Queue
GOR --> Router : (group_job_id, job_entries)
deactivate GOR

Router --> Cliente : 200 {"success":true, "group_job_id":"...",\n"jobs":[{"device":"switch-A","job_id":"...","status":"pending"}]}
deactivate Router

@enduml
