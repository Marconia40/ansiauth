# =============================================================================
# AnsiAuth backend configuration
# Copy this file to `.env` and adjust the values for your environment.
# Every setting can also be supplied via a normal shell environment variable.
# =============================================================================

# ── Execution mode ───────────────────────────────────────────────────────────
# "mock"  — no real Ansible playbooks are dispatched (used by tests and local
#           UI development).
# "real"  — playbooks run against the configured device inventory.
EXECUTION_MODE=mock

# ── Secrets (REQUIRED in production) ─────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_generated_fernet_key_here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_generated_jwt_secret_here

# ── Token lifetimes ──────────────────────────────────────────────────────────
# Access token lifetime in minutes. Default: 20
ACCESS_TOKEN_EXPIRE_MINUTES=20

# Refresh token lifetime in minutes. Default: 240 (4 hours)
REFRESH_TOKEN_EXPIRE_MINUTES=240

# ── Database ─────────────────────────────────────────────────────────────────
# SQLAlchemy URL. Defaults to a SQLite file at backend/app/db/app.db.
# Postgres example: postgresql+psycopg://user:pass@db-host:5432/ansiauth
# DATABASE_URL=sqlite:///./app.db

# ── First-run admin bootstrap ────────────────────────────────────────────────
# Used only when the DB contains no active super-admin yet. After the first
# super-admin is created, these values are ignored.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change_me_to_a_strong_password_min_12_chars

# ── Rate limiting (per minute) ───────────────────────────────────────────────
# RATE_LIMIT_PER_IP=20
# RATE_LIMIT_PER_USER=200
# RATE_LIMIT_LOGIN=5

# ── TLS (optional — usually terminated by a reverse proxy instead) ───────────
# Absolute paths to PEM-encoded certificate/key. When SSL_CERTFILE is set,
# the app installs HSTS + HTTPS-redirect middleware.
# SSL_CERTFILE=
# SSL_KEYFILE=

# ── Audit retention ──────────────────────────────────────────────────────────
# How many days of audit log to keep. Daily purge job at 02:00 UTC. Default: 90
AUDIT_RETENTION_DAYS=90

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins for browser clients. Accepts either:
#   - a JSON list:  CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
#   - a comma-separated string: CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Default: http://localhost:3000,http://127.0.0.1:3000 (dev-friendly)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Cookies ──────────────────────────────────────────────────────────────────
# Refresh-token cookie attributes.
#
# COOKIE_SECURE defaults to True so production deployments behind TLS work
# correctly without any extra flag. Browsers refuse Secure cookies over plain
# HTTP, so local development without TLS MUST set COOKIE_SECURE=false or
# `/auth/login` will appear to succeed but the cookie will never be stored.
COOKIE_SECURE=true

# SameSite policy: "strict" | "lax" | "none". Default: strict.
# Use "none" only if the frontend is hosted on a different registrable domain
# than the API; "none" requires COOKIE_SECURE=true.
COOKIE_SAMESITE=strict
