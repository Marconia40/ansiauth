@startuml "Diagrama de caso de uso - RF-PUERTO-03"
left to right direction

skinparam packageStyle rectangle

actor "Administrador de Red" as Admin

package "API" {
    usecase "Asignar VLAN Taggeada a Trunk" as UC1
    usecase "Verificar Modo Trunk" as UC2
    usecase "Validar Rango VLAN" as UC3
    usecase "Actualizar Lista de VLANs Permitidas" as UC4
    usecase "Notificar Error de Modo Incorrecto" as UC5
    usecase "Registrar Log de Configuración" as UC6
}

Admin --> UC1 : Solicita asignar VLAN (Port, ID)
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>> (Si es Trunk)
UC1 ..> UC6 : <<include>> (Al éxito)

Admin --> UC5 : (Si el puerto NO es Trunk)

note right of UC2
  Pre-requisito: El puerto
  debe estar en modo Trunk
  y no ser Port-Channel
end note

note bottom of UC4
  Garantía: Mantiene las
  VLANs previas y suma la nueva
end note

note right of UC5
  Curso Alternativo: Sugiere
  configurar como Trunk primero
end note

note bottom of UC6
  Excepciones: Puerto inválido,
  VLAN fuera de rango o
  fallo de escritura/red
end note

@enduml